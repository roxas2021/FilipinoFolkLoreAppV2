<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilipinoFolkloreApp.Views.ColoringCollectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="bg/selectionpage.jpg">

    <Grid RowDefinitions="Auto,*" 
          ColumnDefinitions="*"
          Padding="20">

        <!-- ===== HUD Header (Row 0) ===== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Start">

            <!-- LEFT: Avatar + Name/Stars + Hearts -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,Auto,*,Auto" 
                  RowSpacing="4">

                <!-- Avatar -->
                <Frame Grid.RowSpan="2"
                       Grid.Column="0"
                       WidthRequest="80" 
                       HeightRequest="90"
                       CornerRadius="10" 
                       Padding="0"
                       HasShadow="True" 
                       BackgroundColor="White">
                    <Image x:Name="HudAvatar" Aspect="AspectFill" />
                </Frame>

                <!-- Name + Stars pill -->
                <Frame Margin="10,0,0,0"
                       Grid.Row="0" 
                       Grid.Column="1" 
                       BackgroundColor="#5ce1e6"
                       BorderColor="#FF66CC"
                       CornerRadius="10" 
                       Padding="8,4"
                       HorizontalOptions="Start" 
                       VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto" 
                          ColumnSpacing="8" 
                          VerticalOptions="Center">
                        <Label x:Name="PlayerNameLabel"
                               Grid.Column="0" 
                               Text="Player"
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="#FF66CC"
                               VerticalOptions="Center"/>
                        <BoxView Grid.Column="1"/>
                        <Frame Grid.Column="2" 
                               Padding="10,4" 
                               BackgroundColor="#5ce1e6"
                               BorderColor="#FF66CC"
                               CornerRadius="12" 
                               HasShadow="False"
                               VerticalOptions="Center" 
                               Margin="10,0,0,0">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                            </Frame.Shadow>
                            <HorizontalStackLayout Spacing="4">
                                <Label x:Name="StarsLabel" 
                                       Text="0" 
                                       VerticalOptions="Center"
                                       FontAttributes="Bold" 
                                       FontSize="20" 
                                       TextColor="#FFCC00"/>
                                <Image Source="elements/star.png" 
                                       WidthRequest="35" 
                                       HeightRequest="35"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Hearts row -->
                <Frame Grid.Row="1" 
                       Grid.Column="1" 
                       Grid.ColumnSpan="3"
                       CornerRadius="12" 
                       Padding="6,2" 
                       Margin="10,0,0,0"
                       BackgroundColor="White" 
                       HorizontalOptions="Start">
                    <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                </Frame>
            </Grid>

            <!-- RIGHT: Back + Home buttons -->
            <StackLayout Grid.Column="2"
                         Spacing="8"
                         VerticalOptions="Start"
                         Orientation="Horizontal"
                         HorizontalOptions="Start">

                <Image Source="elements/prev.png"
                       WidthRequest="48" 
                       HeightRequest="48"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <Image Source="icon_home.png"
                       WidthRequest="48" 
                       HeightRequest="48"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Image.GestureRecognizers>
                </Image>

            </StackLayout>

        </Grid>

        <!-- Scrollable Grid of Colored Images (Row 1) -->
        <ScrollView Grid.Row="1" Margin="0,10,0,0">
            <VerticalStackLayout x:Name="ColoredImagesContainer" Spacing="10">
                <!-- Items will be added programmatically -->
            </VerticalStackLayout>
        </ScrollView>

        <!-- Image Preview Modal Overlay - Full Screen with Page Margins -->
        <Grid x:Name="ImagePreviewOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="#DD000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnClosePreview"/>
            </Grid.GestureRecognizers>

            <!-- Image Container with Margins -->
            <Border Margin="20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.6"/>
                </Border.Shadow>

                <Grid RowDefinitions="*,Auto" Padding="15">
                    <!-- Preview Image - Takes up most of the space -->
                    <Image x:Name="PreviewImage"
                           Grid.Row="0"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>

                    <!-- Close Button -->
                    <Button Grid.Row="1"
                            Text="✕ Isara"
                            BackgroundColor="#8B4513"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Padding="20,12"
                            Margin="0,15,0,0"
                            Clicked="OnClosePreview"
                            HorizontalOptions="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Empty State Message -->
        <VerticalStackLayout x:Name="EmptyStateContainer"
                            Grid.Row="1"
                            IsVisible="False"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="20">
            <Label Text="Walang Nakulay na Larawan"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#8B4513"
                   HorizontalOptions="Center"/>
            <Label Text="Magkulay muna ng mga larawan upang makita dito!"
                   FontSize="16"
                   TextColor="#8B4513"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>