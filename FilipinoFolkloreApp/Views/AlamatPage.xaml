<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.AlamatPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="homepage_bg.jpg"
             Shell.NavBarIsVisible="False"
             >
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *"
    ColumnDefinitions="*"
    Padding="20">
            <!-- 8-pt grid -->

            <!-- ===== HUD row 0 ===== -->
            <Grid Grid.Row="0"
      ColumnDefinitions="Auto,*,Auto"
      VerticalOptions="Start" >

                <!-- LEFT/MID: Avatar + Name/Stars + Hearts -->
                <Grid Grid.Column="0"
        RowDefinitions="Auto, Auto"
        ColumnDefinitions="Auto, Auto, *, Auto" RowSpacing="4">

                    <!-- Avatar -->
                    <Frame Grid.RowSpan="2"
           Grid.Column="0"
           WidthRequest="80" HeightRequest="90"
           CornerRadius="10" Padding="0"
           HasShadow="True" BackgroundColor="White">
                        <Image x:Name="HudAvatar" Aspect="AspectFill" />
                    </Frame>

                    <!-- Name + Stars pill -->
                    <Frame Margin="10,0,0,0"
           Grid.Row="0" Grid.Column="1" BackgroundColor="#5ce1e6"
        BorderColor="#FF66CC"
           CornerRadius="10" Padding="8,4"
           HorizontalOptions="Start" VerticalOptions="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label x:Name="PlayerNameLabel"
               Grid.Column="0" Text="NICHOL"
               FontAttributes="Bold" FontSize="18" TextColor="#FF66CC"
               VerticalOptions="Center"/>
                            <BoxView Grid.Column="1"/>
                            <Frame Grid.Column="2" Padding="10,4" BackgroundColor="#5ce1e6"
        BorderColor="#FF66CC"
               CornerRadius="12" HasShadow="False"
               VerticalOptions="Center" Margin="10,0,0,0">
                                <Frame.Shadow>
                                    <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                                </Frame.Shadow>
                                <HorizontalStackLayout Spacing="4">
                                    <Label x:Name="StarsLabel" Text="50" VerticalOptions="Center"
                   FontAttributes="Bold" FontSize="20" TextColor="#FFCC00"/>
                                    <Image Source="icon_star_yellow.png" WidthRequest="35" HeightRequest="35"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                    </Frame>

                    <!-- Hearts row -->
                    <Frame Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
           CornerRadius="12" Padding="6,2" Margin="10,0,0,0"
           BackgroundColor="White" HorizontalOptions="Start">
                        <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                    </Frame>
                </Grid>

                <!-- RIGHT: Back + Home buttons (48x48 target, 32px icons) -->
                <StackLayout Grid.Column="2"
                   Spacing="8"
                   VerticalOptions="Start"
                     Orientation="Horizontal"
                   HorizontalOptions="Start">

                    <Image x:Name="BackButton"
                           Source="prev.png"
                 WidthRequest="48" HeightRequest="48"
                 Aspect="AspectFit"
                 Margin="0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image x:Name="HomeButton"
                           Source="icon_home.png"
                 WidthRequest="48" HeightRequest="48"
                 Aspect="AspectFit"
                 Margin="0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </StackLayout>

            </Grid>

            <!-- optional second header row -->
            <ContentView Grid.Row="1"/>

            <!-- Stories grid (scrolls vertically) -->
            <CollectionView x:Name="StoriesView"
                Grid.Row="2"
                SelectionMode="None"
                VerticalScrollBarVisibility="Default">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                     Span="5"
                     VerticalItemSpacing="8"
                     HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Border BackgroundColor="#B3FFFFFF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="*,Auto" Padding="8">
                                    <Image Source="{Binding Thumb}" Aspect="AspectFill" HeightRequest="112" />
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="0,8,0,0" ColumnSpacing="8">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" IsVisible="False"/>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                            <Image Source="ui/lock.png" HeightRequest="16" IsVisible="{Binding IsLocked}"/>
                                            <Border BackgroundColor="#FF69B4" Padding="8,4" IsVisible="{Binding IsLocked}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding PriceText}" 
                                                        FontSize="10" 
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        VerticalOptions="Center"/>
                                                    <Image Source="icon_star_yellow.png"
                                                        WidthRequest="13"
                                                        HeightRequest="13"
                                                        VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStoryTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </Grid>
        <!-- GAME ALERT OVERLAY -->
        <Grid x:Name="GameAlertOverlay"
      Grid.RowSpan="3"
      IsVisible="False"
      Opacity="0"
      BackgroundColor="#40000000"
      HorizontalOptions="Fill"
      VerticalOptions="Fill">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAlertBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame x:Name="GameAlertCard"
               CornerRadius="20"
               Padding="20"
               HasShadow="True"
               BorderColor="Transparent"
               BackgroundColor="#B3FFFFFF"
               WidthRequest="360"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Scale="0.96">

                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">

                        <Label x:Name="AlertMessageLabel"
                       Text="Message"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#333333"
                       Margin="6,0,6,0" />

                        <HorizontalStackLayout x:Name="AlertButtonsPanel"
                                       Spacing="12"
                                       HorizontalOptions="Center">
                            <!-- Yes/No buttons or OK button will be added dynamically -->
                        </HorizontalStackLayout>
                    </StackLayout>
                </Frame>
            </Grid>
        </Grid>

        <!-- Tutorial Overlay -->
        <AbsoluteLayout x:Name="TutorialOverlay" 
                        IsVisible="False"
                        InputTransparent="False">

            <!-- Semi-transparent background -->
            <BoxView BackgroundColor="#99000000"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTutorialNextStep" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Tarsier Character - Left Side -->
            <Image x:Name="TarsierImage" 
                   Source="elements/tarsier.png"
                   WidthRequest="150"
                   HeightRequest="150"
                   Opacity="0"
                   Scale="0.8"
                   AbsoluteLayout.LayoutBounds="30,80,150,150"
                   AbsoluteLayout.LayoutFlags="None" />

            <!-- Speech Bubble Container - Upper Right of Tarsier -->
            <Grid x:Name="SpeechBubbleContainer" 
                  Opacity="0"
                  Scale="0.9"
                  AbsoluteLayout.LayoutBounds="200,50,350,AutoSize"
                  AbsoluteLayout.LayoutFlags="None">

                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 15">
                    <Border.Shadow>
                        <Shadow Brush="Black" 
                                Offset="3,3" 
                                Radius="8" 
                                Opacity="0.3" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="15" Spacing="8">
                        <Label x:Name="TutorialTitleLabel"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FF1493"
                               HorizontalOptions="Center" />

                        <Label x:Name="TutorialMessageLabel"
                               FontSize="14"
                               TextColor="#333333"
                               HorizontalTextAlignment="Start"
                               LineBreakMode="WordWrap" />

                        <Label x:Name="TutorialProgressLabel"
                               Text="1/10"
                               FontSize="12"
                               TextColor="#666666"
                               HorizontalOptions="End"
                               Margin="0,0,0,5" />

                        <HorizontalStackLayout Spacing="15" 
                                               HorizontalOptions="End"
                                               Margin="0,10,0,0">
                            <Button x:Name="PrevTutorialButton"
                                     Text="Bumalik"
                                     BackgroundColor="#FF6B6B"
                                     TextColor="White"
                                     FontAttributes="Bold"
                                     FontSize="12"
                                     CornerRadius="15"
                                     Padding="15,5"
                                     HeightRequest="35"
                                     Clicked="OnTutorialPrevStep" />
                            <Button x:Name="NextTutorialButton"
                                    Text="Susunod"
                                    BackgroundColor="#00A6FF"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="15"
                                    Padding="15,5"
                                    HeightRequest="35"
                                    Clicked="OnTutorialNextStep" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Arrow Pointer (Points to specific elements dynamically) -->
            <Image x:Name="ArrowPointer"
                   Source="arrow_pointer.png"
                   WidthRequest="50"
                   HeightRequest="50"
                   Opacity="0"
                   Scale="0.8"
                   AbsoluteLayout.LayoutBounds="0,0,50,50"
                   AbsoluteLayout.LayoutFlags="None" />
        </AbsoluteLayout>
    </Grid>

</ContentPage>