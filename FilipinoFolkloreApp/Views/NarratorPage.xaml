<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.NarratorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="login_bg.jpeg"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *"
        ColumnDefinitions="*"
        Padding="16">

        <!-- ===== HUD row 0 (8-pt spacing, kid-friendly) ===== -->
        <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="16"
          VerticalOptions="Start">

            <!-- LEFT/MID: Avatar + Name/Stars + Hearts -->
            <Grid Grid.Column="0"
            RowDefinitions="Auto, Auto"
            ColumnDefinitions="Auto, Auto, *, Auto"
            ColumnSpacing="4" RowSpacing ="8">

                <!-- Avatar -->
                <Frame Grid.RowSpan="2"
               Grid.Column="0"
               WidthRequest="80" HeightRequest="88"
               CornerRadius="8" Padding="0"
               HasShadow="True" BackgroundColor="White">
                    <Image x:Name="HudAvatar" Aspect="AspectFill" />
                </Frame>

                <!-- Name + Stars pill -->
                <Frame Margin="16,0,0,0"
               Grid.Row="0" Grid.Column="1"
               BackgroundColor="LightGreen"
               CornerRadius="16" Padding="8,8"
               HorizontalOptions="Start" VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                        <Label x:Name="PlayerNameLabel"
                   Grid.Column="0" Text="NICHOL"
                   FontAttributes="Bold" FontSize="18" TextColor="#FF66CC"
                   VerticalOptions="Center"/>
                        <BoxView Grid.Column="1"/>
                        <Frame Grid.Column="2" Padding="8,4"
                   BackgroundColor="LightGreen" BorderColor="Black"
                   CornerRadius="12" HasShadow="False"
                   VerticalOptions="Center" Margin="8,0,0,0">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                            </Frame.Shadow>
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="StarsLabel" Text="50"
                       FontAttributes="Bold" FontSize="20" TextColor="#FFCC00"/>
                                <Image Source="icon_star_yellow.png" WidthRequest="32" HeightRequest="32"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Hearts row -->
                <Frame Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               CornerRadius="16" Padding="8,8" Margin="16,0,0,0"
               BackgroundColor="White" HorizontalOptions="Start">
                    <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                </Frame>
            </Grid>

            <!-- RIGHT: Prev + Home (no wrapper grids; direct images, 48x48) -->
            <HorizontalStackLayout Grid.Column="2"
                             Spacing="8"
                             VerticalOptions="Center"
                             HorizontalOptions="End">
                <Image Source="prev.png"
               WidthRequest="48" HeightRequest="48"
               Aspect="AspectFit"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <Image Source="icon_home.png"
               WidthRequest="48" HeightRequest="48"
               Aspect="AspectFit"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </HorizontalStackLayout>
        </Grid>

        <!-- optional second header row (leave empty or add title) -->
        <ContentView Grid.Row="1"/>

        <!-- ===== Narrators carousel (8-pt tuned) ===== -->
        <!-- ===== Narrators grid (even columns, centered, 8-pt spacing) ===== -->
        <Grid Grid.Row="2" Padding="16,0,16,0">
            <CollectionView x:Name="NarratorsView"
                  SelectionMode="None"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center"
                  ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemsLayout>
                    <!-- Even grid across the width; auto-wrap to next row -->
                    <GridItemsLayout Orientation="Vertical"
                       Span="{OnIdiom Phone=3, Tablet=5, Desktop=6}"
                       HorizontalItemSpacing="16"
                       VerticalItemSpacing="16"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Each card stretches to its grid cell; content is centered -->
                        <Grid Padding="8"
              HorizontalOptions="Center"
              VerticalOptions="Center">

                            <Border BackgroundColor="#B3FFFFFF"

                  StrokeThickness="0"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Padding="16"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                                    <!-- Avatar size tuned for kids; stays consistent per row -->
                                    <Image Source="{Binding Avatar}"
                     HeightRequest="{OnIdiom Phone=88, Tablet=160, Desktop=176}"
                     WidthRequest="{OnIdiom Phone=88, Tablet=160, Desktop=176}"
                     Aspect="AspectFit"
                     HorizontalOptions="Center" />

                                    <!-- Centered price (only if locked) -->
                                    <!-- Fixed-height price row: stays even when unlocked -->
                                    <Grid Padding="0,8,0,0"
      HeightRequest="{OnIdiom Phone=40, Tablet=32, Desktop=36}"
      HorizontalOptions="Center"
      VerticalOptions="Center">

                                        <!-- Visible only when locked; row height remains either way -->
                                        <HorizontalStackLayout Spacing="8"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         IsVisible="{Binding IsLocked}">
                                            <Image Source="elements/lock.png" HeightRequest="16"/>
                                            <Border BackgroundColor="#FF69B4" Padding="8,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding PriceText}" FontSize="12" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>

                                    </Grid>


                                </VerticalStackLayout>
                            </Border>

                            <!-- whole card tappable -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNarratorTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>


    </Grid>
</ContentPage>
