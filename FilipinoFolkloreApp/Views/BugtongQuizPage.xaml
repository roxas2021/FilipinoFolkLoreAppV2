<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.BugtongQuizPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="narator_bg.jpg"
             Shell.NavBarIsVisible="False">

    <!-- Outer Grid with NO padding to allow full-screen overlay -->
    <Grid>
        <!-- Main content grid WITH padding -->
        <Grid Padding="16"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="16">

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  VerticalOptions="Start">

                <!-- LEFT/MID: Avatar + Name/Stars + Hearts -->
                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="4">

                    <!-- Avatar -->
                    <Frame Grid.RowSpan="2"
                           Grid.Column="0"
                           WidthRequest="80"
                           HeightRequest="90"
                           CornerRadius="10"
                           Padding="0"
                           HasShadow="True"
                           BackgroundColor="White">
                        <Image x:Name="HudAvatar" Aspect="AspectFill"/>
                    </Frame>

                    <!-- Name + Stars pill -->
                    <Frame Margin="10,0,0,0"
                           Grid.Row="0"
                           Grid.Column="1"
                           BackgroundColor="#5ce1e6"
                           BorderColor="#FF66CC"
                           CornerRadius="10"
                           Padding="8,4"
                           HorizontalOptions="Start"
                           VerticalOptions="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label x:Name="PlayerNameLabel"
                                   Grid.Column="0"
                                   Text="NICHOL"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#FF66CC"
                                   VerticalOptions="Center"/>
                            <BoxView Grid.Column="1"/>
                            <Frame Grid.Column="2"
                                   Padding="10,4"
                                   BackgroundColor="#5ce1e6"
                                   BorderColor="#FF66CC"
                                   CornerRadius="12"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0">
                                <Frame.Shadow>
                                    <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                                </Frame.Shadow>
                                <HorizontalStackLayout Spacing="4">
                                    <Label x:Name="StarsLabel"
                                           Text="50"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           FontSize="20"
                                           TextColor="#FFCC00"/>
                                    <Image Source="icon_star_yellow.png" WidthRequest="35" HeightRequest="35"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                    </Frame>

                    <!-- Hearts row -->
                    <Frame Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           CornerRadius="12"
                           Padding="6,2"
                           Margin="10,0,0,0"
                           BackgroundColor="White"
                           HorizontalOptions="Start">
                        <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                    </Frame>
                </Grid>

                <!-- RIGHT: Home button -->
                <StackLayout Grid.Column="2"
                             Spacing="8"
                             VerticalOptions="Start"
                             Orientation="Horizontal"
                             HorizontalOptions="Start">
                    <Image Source="prev.png"
                           WidthRequest="48" 
                           HeightRequest="48"
                           Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Source="icon_home.png"
                           WidthRequest="48"
                           HeightRequest="48"
                           Aspect="AspectFit"
                           Margin="0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>
            </Grid>

            <!-- ===== Question (avatar left, pink pill around text only) ===== -->
            <Grid x:Name="QuizContentWrapper"
                  Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="16">

                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">

                    <Image x:Name="NarratorAvatar"
                           HeightRequest="40"
                           WidthRequest="40"
                           Margin="0,6,8,0"
                           Aspect="AspectFill"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#FF69B4"
                            Padding="12,6"
                            StrokeThickness="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            MaximumWidthRequest="560">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Label x:Name="BugtongPrompt"
                               Text="..."
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="#FFCC00"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </Border>
                </Grid>

                <!-- ===== Answer Display - Individual Letter Boxes ===== -->
                <FlexLayout x:Name="AnswerLetterBoxes"
                            Grid.Row="1"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="0,8"/>
            </Grid>

            <!-- ===== Three Word Choices ===== -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8"
                  Padding="8,0"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">

                <!-- Choice 0: transparent white -->
                <Border x:Name="Choice0Border"
                        BackgroundColor="#ADD8E6"
                        
                        StrokeThickness="0"
                        Padding="16,12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="Choice0"
                           Text="CHOICE 1"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="12,8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPick0"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

                <!-- Choice 1: transparent red -->
                <Border Grid.Column="1"
                        x:Name="Choice1Border"
                        BackgroundColor="#ADD8E6"
                        StrokeThickness="0"
                        Padding="16,12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="Choice1"
                           Text="CHOICE 2"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="12,8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPick1"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

                <!-- Choice 2: transparent yellow -->
                <Border Grid.Column="2"
                        x:Name="Choice2Border"
                        BackgroundColor="#ADD8E6"
                        StrokeThickness="0"
                        Padding="16,12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="Choice2"
                           Text="CHOICE 3"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="12,8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPick2"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Grid>

        <!-- Modal overlay - OUTSIDE the padded grid, at root level -->
        <Grid x:Name="GameAlertOverlay"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#40000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">
            <!-- Prevent clicks from passing through -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayBackgroundTapped"/>
            </Grid.GestureRecognizers>

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame x:Name="GameAlertCard"
                       CornerRadius="20"
                       Padding="16"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="#B3FFFFFF"
                       WidthRequest="420"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Scale="0.96">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <Image x:Name="AlertNarrator"
                               Grid.RowSpan="3"
                               HeightRequest="96"
                               WidthRequest="96"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                        <Grid Grid.Column="1"
                              Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              VerticalOptions="Center">
                            <Label Text="Subukan muli ang bugtong?"
                                   FontSize="18"
                                   TextColor="#FFCC00"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Center"/>
                            <Image Grid.Column="1"
                                   Source="ui/close.png"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAlertCloseTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                        <HorizontalStackLayout x:Name="AlertHeartsPanel"
                                               Grid.Column="1"
                                               Grid.Row="1"
                                               Spacing="8"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>

                        <Label Grid.Column="1"
                               Grid.Row="2"
                               Text="Subukan Muli"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               Padding="20,10">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlertRetryTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Frame>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>