<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.MgaLaroPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="homepage_bg.jpg"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto, Auto, *"
          ColumnDefinitions="*"
          Padding="20">

        <!-- ===== HUD Header (Row 0) ===== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Start">

            <!-- LEFT: Avatar + Name/Stars + Hearts -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto, Auto"
                  ColumnDefinitions="Auto, Auto, *, Auto" 
                  RowSpacing="4">

                <!-- Avatar -->
                <Frame Grid.RowSpan="2"
                       Grid.Column="0"
                       WidthRequest="80" 
                       HeightRequest="90"
                       CornerRadius="10" 
                       Padding="0"
                       HasShadow="True" 
                       BackgroundColor="White">
                    <Image x:Name="HudAvatar" Aspect="AspectFill" />
                </Frame>

                <!-- Name + Stars pill -->
                <Frame Margin="10,0,0,0"
                       Grid.Row="0" 
                       Grid.Column="1" 
                       BackgroundColor="#5ce1e6"
                       BorderColor="#FF66CC"
                       CornerRadius="10" 
                       Padding="8,4"
                       HorizontalOptions="Start" 
                       VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto" 
                          ColumnSpacing="8" 
                          VerticalOptions="Center">
                        <Label x:Name="PlayerNameLabel"
                               Grid.Column="0" 
                               Text="Player"
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="#FF66CC"
                               VerticalOptions="Center"/>
                        <BoxView Grid.Column="1"/>
                        <Frame Grid.Column="2" 
                               Padding="10,4" 
                               BackgroundColor="#5ce1e6"
                               BorderColor="#FF66CC"
                               CornerRadius="12" 
                               HasShadow="False"
                               VerticalOptions="Center" 
                               Margin="10,0,0,0">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                            </Frame.Shadow>
                            <HorizontalStackLayout Spacing="4">
                                <Label x:Name="StarsLabel" 
                                       Text="0" 
                                       VerticalOptions="Center"
                                       FontAttributes="Bold" 
                                       FontSize="20" 
                                       TextColor="#FFCC00"/>
                                <Image Source="icon_star_yellow.png" 
                                       WidthRequest="35" 
                                       HeightRequest="35"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Hearts row -->
                <Frame Grid.Row="1" 
                       Grid.Column="1" 
                       Grid.ColumnSpan="3"
                       CornerRadius="12" 
                       Padding="6,2" 
                       Margin="10,0,0,0"
                       BackgroundColor="White" 
                       HorizontalOptions="Start">
                    <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                </Frame>
            </Grid>

            <!-- RIGHT: Back + Home buttons -->
            <StackLayout Grid.Column="2"
                         Spacing="8"
                         VerticalOptions="Start"
                         Orientation="Horizontal"
                         HorizontalOptions="Start">

                <Image Source="prev.png"
                       WidthRequest="48" 
                       HeightRequest="48"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <Image Source="icon_home.png"
                       WidthRequest="48" 
                       HeightRequest="48"
                       Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Image.GestureRecognizers>
                </Image>

            </StackLayout>

        </Grid>

        <!-- Optional second header row -->
        <ContentView Grid.Row="1"/>

        <!-- Games Buttons and Image (Row 2) - Vertically Centered -->
        <Grid Grid.Row="2"
              HorizontalOptions="Fill"
              VerticalOptions="Center">

            <!-- Buttons - Centered -->
            <VerticalStackLayout Spacing="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                <!-- Bugtong Button -->
                <Button Text="BUGTONG"
                        BackgroundColor="#FF6347"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="40" 
                        WidthRequest="130"
                        HeightRequest="40"
                        Clicked="OnBugtongTapped"/>

                <!-- Magpinta Button -->
                <Button Text="MAGKULAY"
                        BackgroundColor="#3399CC"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="40"
                        WidthRequest="130"
                        HeightRequest="40"
                        Clicked="OnMagpintaTapped"/>

            </VerticalStackLayout>

            <!-- Replace the Narrator Tree Image and character sections with this: -->

            <!-- Narrator Tree Image - Positioned to the left of buttons -->
            <Image Source="narratortree.png"
       HorizontalOptions="Center"
       VerticalOptions="Center"
       Aspect="AspectFit"
       WidthRequest="200"
       HeightRequest="200"
       TranslationX="-200">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNarratorTreeTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- Narrator Character Image - Centered on narratortree.png -->
            <Image x:Name="NarratorImage"
       HorizontalOptions="Center"
       VerticalOptions="Center"
       Aspect="AspectFit"
       WidthRequest="50"
       HeightRequest="50"
       TranslationX="-200">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNarratorTreeTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- Narrator Battery Image - To the right of narrator character -->
            <Image x:Name="NarratorBatteryImage"
       HorizontalOptions="Center"
       VerticalOptions="Center"
       Aspect="AspectFit"
       WidthRequest="25"
       HeightRequest="25"
       TranslationX="-165"
       TranslationY="0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNarratorTreeTapped"/>
                </Image.GestureRecognizers>
            </Image>

        </Grid>
    </Grid>
</ContentPage>