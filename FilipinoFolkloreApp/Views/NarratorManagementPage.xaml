<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.NarratorManagementPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="homepage_bg.jpg"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *"
      ColumnDefinitions="*"
      Padding="20">

            <!-- ===== HUD Header (Row 0) ===== -->
            <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto"
          VerticalOptions="Start">

                <!-- LEFT: Avatar + Name/Stars + Hearts -->
                <Grid Grid.Column="0"
              RowDefinitions="Auto, Auto"
              ColumnDefinitions="Auto, Auto, *, Auto" 
              RowSpacing="4">

                    <!-- Avatar -->
                    <Frame Grid.RowSpan="2"
                   Grid.Column="0"
                   WidthRequest="80" 
                   HeightRequest="90"
                   CornerRadius="10" 
                   Padding="0"
                   HasShadow="True" 
                   BackgroundColor="White">
                        <Image x:Name="HudAvatar" Aspect="AspectFill" />
                    </Frame>

                    <!-- Name + Stars pill -->
                    <Frame Margin="10,0,0,0"
                   Grid.Row="0" 
                   Grid.Column="1" 
                   BackgroundColor="#5ce1e6"
                   BorderColor="#FF66CC"
                   CornerRadius="10" 
                   Padding="8,4"
                   HorizontalOptions="Start" 
                   VerticalOptions="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto" 
                      ColumnSpacing="8" 
                      VerticalOptions="Center">
                            <Label x:Name="PlayerNameLabel"
                           Grid.Column="0" 
                           Text="Player"
                           FontAttributes="Bold" 
                           FontSize="18" 
                           TextColor="#FF66CC"
                           VerticalOptions="Center"/>
                            <BoxView Grid.Column="1"/>
                            <Frame Grid.Column="2" 
                           Padding="10,4" 
                           BackgroundColor="#5ce1e6"
                           BorderColor="#FF66CC"
                           CornerRadius="12" 
                           HasShadow="False"
                           VerticalOptions="Center" 
                           Margin="10,0,0,0">
                                <Frame.Shadow>
                                    <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                                </Frame.Shadow>
                                <HorizontalStackLayout Spacing="4">
                                    <Label x:Name="StarsLabel" 
                                   Text="0" 
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" 
                                   FontSize="20" 
                                   TextColor="#FFCC00"/>
                                    <Image Source="icon_star_yellow.png" 
                                   WidthRequest="35" 
                                   HeightRequest="35"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                    </Frame>

                    <!-- Hearts row -->
                    <Frame Grid.Row="1" 
                   Grid.Column="1" 
                   Grid.ColumnSpan="3"
                   CornerRadius="12" 
                   Padding="6,2" 
                   Margin="10,0,0,0"
                   BackgroundColor="White" 
                   HorizontalOptions="Start">
                        <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                    </Frame>
                </Grid>

                <!-- RIGHT: Back + Home buttons -->
                <StackLayout Grid.Column="2"
                     Spacing="8"
                     VerticalOptions="Start"
                     Orientation="Horizontal"
                     HorizontalOptions="Start">

                    <Image Source="prev.png"
                   WidthRequest="48" 
                   HeightRequest="48"
                   Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Source="icon_home.png"
                       WidthRequest="48"
                       HeightRequest="48"
                       Aspect="AspectFit"
                       Margin="0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Image.GestureRecognizers>
                    </Image>


                </StackLayout>

            </Grid>

            <!-- Optional second header row -->
            <ContentView Grid.Row="1"/>

            <!-- Narrator List -->
            <Grid Grid.Row="2" Padding="16,0,16,0">
                <CollectionView x:Name="NarratorsView"
                        SelectionMode="None"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=3, Tablet=5, Desktop=6}"
                                 HorizontalItemSpacing="16"
                                 VerticalItemSpacing="16"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">

                                <Border BackgroundColor="#B3FFFFFF"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Padding="16"
                                                 Spacing="8"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">

                                        <!-- Narrator Image Container -->
                                        <Grid WidthRequest="{OnIdiom Phone=88, Tablet=160, Desktop=176}"
                                      HeightRequest="{OnIdiom Phone=88, Tablet=160, Desktop=176}">

                                            <!-- Narrator Image -->
                                            <Image Source="{Binding Avatar}"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Opacity="{Binding Opacity}"/>

                                            <!-- Battery Image (for unlocked narrators) -->
                                            <Image Source="{Binding BatteryImage}"
                                           WidthRequest="30"
                                           HeightRequest="30"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="0,5,5,0"
                                           IsVisible="{Binding ShowBattery}"/>
                                        </Grid>

                                        <!-- Price (for locked narrators) -->
                                        <Grid Padding="0,4,0,0"
                                      HeightRequest="{OnIdiom Phone=32, Tablet=32, Desktop=36}"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center">

                                            <HorizontalStackLayout Spacing="8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding IsLocked}">
                                                <Border BackgroundColor="#FF69B4" 
                                                Padding="8,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding Price}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       VerticalOptions="Center"/>
                                                        <Image Source="icon_star_yellow.png"
                                                       WidthRequest="16"
                                                       HeightRequest="16"
                                                       VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </HorizontalStackLayout>

                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>

                                <!-- Tap gesture -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNarratorTapped"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- GAME ALERT OVERLAY -->
            

        </Grid>
        <Grid x:Name="GameAlertOverlay"
Grid.RowSpan="3"
IsVisible="False"
Opacity="0"
BackgroundColor="#40000000"
HorizontalOptions="Fill"
VerticalOptions="Fill">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAlertBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame x:Name="GameAlertCard"
         CornerRadius="20"
         Padding="20"
         HasShadow="True"
         BorderColor="Transparent"
         BackgroundColor="#B3FFFFFF"
         WidthRequest="360"
         HorizontalOptions="Center"
         VerticalOptions="Center"
         Scale="0.96">

                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">

                        <Label x:Name="AlertMessageLabel"
                 Text="Message"
                 FontSize="18"
                 FontAttributes="Bold"
                 HorizontalOptions="Center"
                 HorizontalTextAlignment="Center"
                 TextColor="#333333"
                 Margin="6,0,6,0" />

                        <HorizontalStackLayout x:Name="AlertButtonsPanel"
                                 Spacing="12"
                                 HorizontalOptions="Center">
                            <!-- Yes/No buttons or OK button will be added dynamically -->
                        </HorizontalStackLayout>
                    </StackLayout>
                </Frame>
            </Grid>
        </Grid>
    </Grid>
    
</ContentPage>