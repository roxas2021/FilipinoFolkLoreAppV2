<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="FilipinoFolkloreApp.Views.ColoringPage"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="selectionpage.jpg"
             BackgroundColor="#F5F5DC">
    <Grid>
        <Grid RowDefinitions="Auto,*" 
      ColumnDefinitions="*,Auto"
      Padding="20">

            <!-- ===== HUD Header (Row 0, spanning both columns) ===== -->
            <Grid Grid.Row="0"
          Grid.ColumnSpan="2"
          ColumnDefinitions="Auto,*,Auto"
          VerticalOptions="Start"
          Margin="0,0,0,10">

                <!-- LEFT: Avatar + Name/Stars + Hearts -->
                <Grid Grid.Column="0"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,Auto,*,Auto" 
              RowSpacing="4">

                    <!-- Avatar -->
                    <Frame Grid.RowSpan="2"
                   Grid.Column="0"
                   WidthRequest="80" 
                   HeightRequest="90"
                   CornerRadius="10" 
                   Padding="0"
                   HasShadow="True" 
                   BackgroundColor="White">
                        <Image x:Name="HudAvatar" Aspect="AspectFill" />
                    </Frame>

                    <!-- Name + Stars pill -->
                    <Frame Margin="10,0,0,0"
                   Grid.Row="0" 
                   Grid.Column="1" 
                   BackgroundColor="#5ce1e6"
                   BorderColor="#FF66CC"
                   CornerRadius="10" 
                   Padding="8,4"
                   HorizontalOptions="Start" 
                   VerticalOptions="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto" 
                      ColumnSpacing="8" 
                      VerticalOptions="Center">
                            <Label x:Name="PlayerNameLabel"
                           Grid.Column="0" 
                           Text="Player"
                           FontAttributes="Bold" 
                           FontSize="18" 
                           TextColor="#FF66CC"
                           VerticalOptions="Center"/>
                            <BoxView Grid.Column="1"/>
                            <Frame Grid.Column="2" 
                           Padding="10,4" 
                           BackgroundColor="#5ce1e6"
                           BorderColor="#FF66CC"
                           CornerRadius="12" 
                           HasShadow="False"
                           VerticalOptions="Center" 
                           Margin="10,0,0,0">
                                <Frame.Shadow>
                                    <Shadow Brush="Black" Offset="-4,4" Radius="8" Opacity="0.5"/>
                                </Frame.Shadow>
                                <HorizontalStackLayout Spacing="4">
                                    <Label x:Name="StarsLabel" 
                                   Text="0" 
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" 
                                   FontSize="20" 
                                   TextColor="#FFCC00"/>
                                    <Image Source="icon_star_yellow.png" 
                                   WidthRequest="35" 
                                   HeightRequest="35"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>
                    </Frame>

                    <!-- Hearts row -->
                    <Frame Grid.Row="1" 
                   Grid.Column="1" 
                   Grid.ColumnSpan="3"
                   CornerRadius="12" 
                   Padding="6,2" 
                   Margin="10,0,0,0"
                   BackgroundColor="White" 
                   HorizontalOptions="Start">
                        <HorizontalStackLayout x:Name="HeartsPanel" Spacing="8"/>
                    </Frame>
                </Grid>

                <!-- RIGHT: Undo + Save + Back + Home buttons -->
                <StackLayout Grid.Column="2"
                     Spacing="8"
                     VerticalOptions="Start"
                     Orientation="Horizontal"
                     HorizontalOptions="Start">

                    <Button x:Name="UndoButton"
                    Text="Undo" 
                    BackgroundColor="#FF9800" 
                    TextColor="white"
                    FontAttributes="Bold"
                    CornerRadius="40"
                    Clicked="OnUndoClicked"
                    IsEnabled="False"
                    Padding="15,8"
                    VerticalOptions="Center"/>

                    <Button x:Name="SaveButton"
                    Text="I-Save" 
                    BackgroundColor="Green" 
                    TextColor="white"
                    FontAttributes="Bold"
                    CornerRadius="40"
                    Clicked="OnSaveClicked"
                    Padding="15,8"
                    VerticalOptions="Center"/>

                    <Image Source="elements/prev.png"
                   WidthRequest="48" 
                   HeightRequest="48"
                   Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image Source="icon_home.png"
                   WidthRequest="48" 
                   HeightRequest="48"
                   Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </StackLayout>

            </Grid>

            <!-- Canvas Area -->
            <Frame Grid.Row="1" 
           Grid.Column="0"
           Margin="0,0,10,0" 
           Padding="0" 
           BackgroundColor="White"
           HasShadow="True">
                <skia:SKCanvasView 
            x:Name="ColoringCanvas"
            PaintSurface="OnPaintSurface"
            Touch="OnCanvasTouch"
            EnableTouchEvents="True"/>
            </Frame>

            <!-- Color Palette - Right Side Vertical -->
            <Border Grid.Row="1"
            Grid.Column="1"
            BackgroundColor="#D2B48C"
            StrokeThickness="0"
            Padding="0"
            WidthRequest="100">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Grid Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                   Text="Pumili ng Kulay:" 
                   TextColor="#8B4513"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,0,0,10"
                   HorizontalOptions="Center"/>

                    <ScrollView Grid.Row="1" 
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="ColorPalette" 
                                    Spacing="15" 
                                    Padding="5"
                                    HorizontalOptions="Center">
                            <!-- Colors will be added programmatically -->
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                      Grid.Row="1"
                      Grid.Column="0"
                      IsRunning="False"
                      IsVisible="False"
                      Color="#8B4513"
                      WidthRequest="50"
                      HeightRequest="50"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>

            <!-- GAME ALERT OVERLAY -->


        </Grid>
        <Grid x:Name="GameAlertOverlay"
  Grid.RowSpan="2"
  Grid.ColumnSpan="2"
  IsVisible="False"
  Opacity="0"
  BackgroundColor="#40000000"
  HorizontalOptions="Fill"
  VerticalOptions="Fill">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAlertBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <Frame x:Name="GameAlertCard"
           CornerRadius="20"
           Padding="20"
           HasShadow="True"
           BorderColor="Transparent"
           BackgroundColor="#B3FFFFFF"
           WidthRequest="360"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           Scale="0.96">

                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">

                        <Label x:Name="AlertMessageLabel"
                   Text="Message"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#333333"
                   Margin="6,0,6,0" />

                        <HorizontalStackLayout x:Name="AlertButtonsPanel"
                                   Spacing="12"
                                   HorizontalOptions="Center">
                            <!-- Yes/No buttons or OK button will be added dynamically -->
                        </HorizontalStackLayout>
                    </StackLayout>
                </Frame>
            </Grid>
        </Grid>
    </Grid>


</ContentPage>