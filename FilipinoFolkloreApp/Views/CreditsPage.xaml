<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FilipinoFolkloreApp.Views.CreditsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="image4.jpg"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*"
          Padding="20">

        <!-- Back Button Row - Upper Right -->
        <StackLayout Grid.Row="0"
                     Spacing="8"
                     VerticalOptions="Start"
                     Orientation="Horizontal"
                     HorizontalOptions="End">

            <Image Source="prev.png"
                   WidthRequest="48"
                   HeightRequest="48"
                   Aspect="AspectFit"
                   Margin="0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Image.GestureRecognizers>
            </Image>

        </StackLayout>

        <!-- Credits Frame -->
        <Frame Grid.Row="1"
               CornerRadius="20"
               BackgroundColor="#E6FFFFFF"
               Padding="30"
               HasShadow="True"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               WidthRequest="500"
               Margin="0,20,0,0">
            <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.3"/>
            </Frame.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="8">

                    <!-- App Icon -->
                    <Image Source="appiconforcredits.png"
                           WidthRequest="240"
                           HeightRequest="120"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10"/>

                    <!-- Research and Paperworks Section -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RESEARCH &amp; PAPERWORKS"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="DeepPink"
                               HorizontalOptions="Center"/>
                        <Label Text="Diana Jonna C. Malasaga"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center"/>
                        <Label Text="Patrica Tabua"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#333"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Prototype & Design Section -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PROTOTYPE &amp; DESIGN"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="DeepPink"
                               HorizontalOptions="Center"/>
                        <Label Text="Nichol Angeline Alim"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Stories & Game Development Section -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="STORIES &amp; GAME DEVELOPMENT"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="DeepPink"
                               HorizontalOptions="Center"/>
                        <Label Text="Cliff John Sadagnot"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center"/>
                        <Label Text="Charles Vincent Lising"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>